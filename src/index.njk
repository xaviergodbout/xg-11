---
layout: base.njk
title: Personal Link Directory
description: A curated directory of projects, tools, servers, and links by x-g.ca.
---

<main id="main-content" class="page-content" aria-labelledby="page-title">
    <h1 id="page-title" class="visually-hidden">x-g.ca personal link directory</h1>

    <section class="links" aria-label="Link categories">
        {% for section in linkSections %}
            {% set sectionIndex = loop.index %}
            <article class="links-container {{ section.class }}" aria-labelledby="section-{{ loop.index }}-title">
                <h2 id="section-{{ loop.index }}-title" class="section-title">
                    {{ section.title }}
                    <span class="link-count" aria-label="{{ section.links | length }} links">({{ section.links | length }})</span>
                </h2>

                <ul class="link-list">
                    {% for item in section.links %}
                        {% set linkId = 'link-' ~ sectionIndex ~ '-' ~ loop.index %}
                        <li class="link-list__item">
                            <a
                                id="{{ linkId }}"
                                href="{{ item.url }}"
                                class="link"
                                style="--link-anchor: --{{ linkId }};"
                                {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}
                                aria-describedby="{{ linkId }}-description"
                            >
                                <span class="link__label">
                                    <img
                                        class="link__icon"
                                        src="{{ item.icon }}"
                                        alt=""
                                        width="16"
                                        height="16"
                                        loading="lazy"
                                        decoding="async"
                                        aria-hidden="true"
                                    >
                                    <span class="hide-gv">{{ item.label }}</span>
                                </span>
                                <span id="{{ linkId }}-description" class="link__description">{{ item.description }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </article>
        {% endfor %}

        <article id="serverlist-wrapper" class="links-container serverlist-wrapper" aria-labelledby="server-links-title" hidden>
            <h2 id="server-links-title" class="visually-hidden">Server links</h2>

            <div id="secure-server-links" class="secure-server-links" aria-live="polite"></div>
        </article>
    </section>
</main>
