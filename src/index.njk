---
layout: base.njk
title: x-g.ca | Link Index
---

<section class="links">
    {% for section in linkSections %}
        <div class="links-container {{ section.class }}">
            <h2>{{ section.title }}</h2>

            <ul>
                {% for item in section.links %}
                    <li>
                        <a
                            href="{{ item.url }}"
                            class="link"
                            {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}
                        >
                            <span>
                                <img src="{{ item.icon }}" alt="{{ item.alt }}">
                                <span class="hide-gv">{{ item.label }}</span>
                            </span>
                            <p>{{ item.description }}</p>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endfor %}

    <div class="links-container serverlist-wrapper">
        <button id="server-login-btn" class="link" style="cursor: pointer;">
            <span class="theme-light__label"></span> /server
        </button>
        <div id="secure-server-links"></div>
    </div>
</section>
