<header class="site-header">
    <a class="logo" href="/" aria-label="x-g home">
        <img src="/img/x-g_logo_spin.gif" alt="x-g logo" width="100" height="42" fetchpriority="high" decoding="async">
    </a>

    <label class="theme-toggle" for="theme-toggle">
        <span class="theme-dark__label" aria-hidden="true"></span>
        <input type="checkbox" id="theme-toggle" aria-label="Toggle light or dark theme">
        <span class="theme-toggle__track" aria-hidden="true">
            <span class="theme-toggle__thumb"></span>
        </span>
        <span class="theme-light__label" aria-hidden="true"></span>
    </label>
</header>
